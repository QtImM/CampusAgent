# ── DeepSeek (LLM) — required ───────────────────────────────────
EXPO_PUBLIC_DEEPSEEK_API_KEY=your_deepseek_api_key
EXPO_PUBLIC_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
EXPO_PUBLIC_AGENT_FAST_MODEL=deepseek-chat
EXPO_PUBLIC_AGENT_REASONING_MODEL=deepseek-reasoner

# ── Supabase — required for schedule / building / FAQ-KB / memory tools ──
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ── Agent runtime flags (optional) ──────────────────────────────
EXPO_PUBLIC_ACTION_AGENT_ENABLED=true
EXPO_PUBLIC_REACT_RUNTIME_ENABLED=true
EXPO_PUBLIC_REACT_MAX_ITERATIONS=5
EXPO_PUBLIC_REACT_TIMEOUT_MS=30000

# ── Retrieval: hybrid recall + RRF fusion (P1, optional) ─────────
EXPO_PUBLIC_HYBRID_SEARCH_ENABLED=true
EXPO_PUBLIC_RRF_K=60
EXPO_PUBLIC_EVIDENCE_TOP_K=4

# ── Retrieval: cross-encoder rerank (P1, optional) ───────────────
# RERANKER_PROVIDER: none (heuristic only, default) | cohere | local
EXPO_PUBLIC_RERANKER_PROVIDER=none
EXPO_PUBLIC_COHERE_API_KEY=
EXPO_PUBLIC_COHERE_RERANK_MODEL=rerank-multilingual-v3.0
# Self-hosted bge-reranker-v2-m3 endpoint exposing POST /rerank
EXPO_PUBLIC_RERANKER_URL=
EXPO_PUBLIC_RERANKER_TIMEOUT_MS=3000

# ── Server ──────────────────────────────────────────────────────
PORT=3000
