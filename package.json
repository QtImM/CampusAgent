{
  "name": "campus-agent",
  "version": "1.0.0",
  "description": "Standalone HKBU CampusAgent — DeepSeek LangGraph agent (with ReAct fallback) and a local web frontend, extracted from HKCampus.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "eval:retrieve": "tsx eval/retrieve_cli.ts eval/dataset.jsonl > eval/retrieval_runs.jsonl",
    "eval": "npm run eval:retrieve && python eval/run_eval.py"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.3.7",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
